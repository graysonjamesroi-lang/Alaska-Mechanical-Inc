# RESEND_API_KEY: Resend API key for dispatching notification emails upon form submission
RESEND_API_KEY="re_1234567890abcdef"

# BOOKING_EMAIL_TO: Destination address to receive dispatch inquiries (Private)
BOOKING_EMAIL_TO="inquiries@example.com"

# BOOKING_FROM_EMAIL: Sender address configured in Resend domains
BOOKING_FROM_EMAIL="notifications@example.com"

# APP_URL: Production or preview URL
APP_URL="https://example.com"
